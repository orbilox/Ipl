# ─── DATABASE (Railway PostgreSQL) ───────────────────────────────────────────
# Pooled connection URL — used at runtime by the Next.js app
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct (non-pooled) URL — used by Prisma Migrate; on Railway this is DATABASE_PUBLIC_URL
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── NEXT AUTH ────────────────────────────────────────────────────────────────
# Full URL of your deployed app (no trailing slash)
NEXTAUTH_URL="https://your-app.vercel.app"
# Random 32+ char secret: run → openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-random-secret-here"

# ─── CRICKET LIVE DATA (CricAPI — https://cricapi.com) ───────────────────────
CRICKET_API_KEY="your-cricapi-key"
CRICKET_API_BASE="https://api.cricapi.com/v1"

# ─── PAYMENTS (Razorpay — https://razorpay.com) ───────────────────────────────
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# ─── APP ──────────────────────────────────────────────────────────────────────
APP_URL="https://your-app.vercel.app"
ADMIN_EMAIL="admin@ipltrading.com"
ADMIN_PASSWORD="Admin@123456"
